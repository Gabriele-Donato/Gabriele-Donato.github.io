--- a/_config.yml
+++ b/_config.yml
@@ -30,6 +30,29 @@ url: "https://gabriele-donato.github.io" # the base hostname & protocol for your
 twitter_username: jekyllrb
 github_username:  jekyll
 
+# ---------------------------------------------------------------------------
+# Zettelkasten
+# ---------------------------------------------------------------------------
+# Notes live in _zettels/ as their own collection, so they never appear in the
+# chronological blog feed on the home page, in the RSS feed, or in `site.posts`.
+# `output: true` gives each note its own page at /zettel/<filename>/ — which is
+# what the modal on /zettelkasten/ fetches for the preview body.
+collections:
+  zettels:
+    output: true
+    permalink: /zettel/:name/
+
+# Defaults for notes only, so a note needs neither `layout:` nor `image:` in its
+# front matter. Nothing outside _zettels/ is affected — posts and pages keep
+# setting their own `image:` exactly as they do today.
+defaults:
+  - scope:
+      path: ""
+      type: zettels
+    values:
+      layout: zettel
+      image: /assets/images/rambosson.jpg
+
 # Build settings
 theme: jekyll-theme-cayman
 plugins:
